# ============================================================
# LOCAL DEVELOPMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to: application-local.properties
# Fill in your local values — this file is in .gitignore
# NEVER commit application-local.properties to version control
# ============================================================

# Database credentials (local dev)
DB_URL=jdbc:mysql://localhost:3306/smartServicebooking?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_local_password_here

# JWT Secret — use a strong random string (min 32 chars) in production
# Generate one: openssl rand -base64 64
JWT_SECRET=replace_me_with_a_strong_random_secret_of_at_least_32_characters

# Token expiry in milliseconds (default 24h = 86400000)
JWT_EXPIRATION=86400000

# CORS — comma-separated list of allowed frontend origins
cors.allowed-origins=http://localhost:3000,http://localhost:8080
